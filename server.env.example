# Copy this file to server.env and replace the example secrets before use.
DATABASE_URL=postgres://new_yokosuka:change-me@127.0.0.1:5432/new_yokosuka?sslmode=disable
ADMIN_KEY=replace-with-the-dashboard-admin-key
COOKIE_SECURE=false
HTTP_ADDR=:8080
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_CONNECTIONS=100
ACTIVITY_LOG_PATH=activity/events.jsonl

# Optional world configuration.
# WORLD_SEASON=summer
# WORLD_WEATHER=clear
# WORLD_EPOCH_UNIX_MS=1700000000000

# Enables server-side Yarn compilation and scripted events when the compiler
# bridge is installed at this path.
# YARN_COMPILER_PATH=/opt/new-yokosuka-server/yarn-compiler/NewYokosuka.YarnCompiler

# Optional Discord game-chat bridge. Configure both or neither.
# DISCORD_CHAT_SHARED_SECRET=
# DISCORD_CHAT_WEBHOOK_URL=
